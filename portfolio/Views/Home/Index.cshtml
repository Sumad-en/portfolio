@{
    ViewData["Title"] = "Lobotomy Corporation // Central Command Team";
}

<style>
    body {
        background-color: #0c0b08;
    }

    .lobotomy-home {
        color: #f5eedc;
        font-family: 'Consolas', 'Courier New', monospace;
        padding: 25px 10px;
    }

    .corp-header {
        background: linear-gradient(135deg, #2b220c, #12100a);
        border: 2px solid #d49b00;
        padding: 35px;
        text-align: center;
        position: relative;
        box-shadow: 0 0 25px rgba(255, 190, 11, 0.22);
    }

    .corp-logo {
        font-size: 65px;
        color: #ffbe0b;
        margin-bottom: 10px;
        text-shadow: 0 0 15px rgba(255, 190, 11, 0.5);
    }

    .corp-title {
        font-size: 38px;
        font-weight: 700;
        letter-spacing: 5px;
        color: #ffbe0b;
    }

    .corp-subtitle {
        color: #c2b082;
        letter-spacing: 4px;
        font-size: 12px;
    }

    .corp-status {
        background: #ffbe0b;
        color: #12100a;
        padding: 7px 15px;
        font-weight: 700;
        font-size: 12px;
        display: inline-block;
        margin-top: 20px;
        letter-spacing: 1.5px;
    }

    .section-heading {
        color: #ffbe0b;
        border-bottom: 1px solid #997000;
        padding-bottom: 12px;
        margin: 35px 0 20px;
        letter-spacing: 2px;
        font-size: 20px;
        font-weight: 700;
    }

    .department-card {
        background: linear-gradient(145deg, #241d0e, #12100a);
        border: 1px solid #7a5900;
        padding: 25px;
        height: 100%;
        transition: 0.3s;
    }

        .department-card:hover {
            border-color: #ffbe0b;
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(255, 190, 11, 0.25);
        }

    .department-icon {
        font-size: 38px;
        color: #ffbe0b;
        margin-bottom: 15px;
    }

    .department-card h4 {
        color: #ffbe0b;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .department-card p {
        color: #bfb18e;
        font-size: 14px;
        min-height: 45px;
    }

    .corp-button {
        display: inline-block;
        background: #d49b00;
        color: #12100a;
        padding: 10px 20px;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 1.5px;
        transition: 0.3s;
    }

        .corp-button:hover {
            background: #ffd13b;
            color: #000000;
            box-shadow: 0 0 12px rgba(255, 190, 11, 0.55);
        }

    .warning-panel {
        background: rgba(166, 124, 0, 0.16);
        border: 1px solid #a67c00;
        border-left: 5px solid #ffbe0b;
        padding: 20px;
        margin-top: 30px;
    }

        .warning-panel h5 {
            color: #ffbe0b;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .warning-panel p {
            color: #d6cbb0;
            margin-bottom: 0;
        }

    .corp-footer {
        text-align: center;
        color: #857652;
        font-size: 11px;
        letter-spacing: 3px;
        margin-top: 40px;
    }

    @@media (max-width: 768px) {
        .corp-title {
            font-size: 25px;
        }

        .corp-header {
            padding: 25px 12px;
        }
    }
</style>

<div class="lobotomy-home">

    <!-- CORPORATION HEADER -->

    <div class="corp-header">

        <div class="corp-logo">
            <i class="bi bi-sun-fill"></i>
        </div>

        <h1 class="corp-title">
            LOBOTOMY CORPORATION
        </h1>

        <p class="corp-subtitle">
            CENTRAL COMMAND TEAM // FACE THE FEAR, BUILD THE FUTURE
        </p>

        <div class="corp-status">
            <i class="bi bi-circle-fill"></i>
            CENTRAL COMMAND ONLINE
        </div>

    </div>

    <!-- MANAGER WELCOME -->

    <h3 class="section-heading">
        <i class="bi bi-person-badge"></i>
        MANAGER'S TERMINAL
    </h3>

    <div class="warning-panel">

        <h5>
            <i class="bi bi-exclamation-triangle-fill"></i>
            ATTENTION, MANAGER.
        </h5>

        <p>
            Welcome to the facility management system.
            All employee records, project documentation,
            and archived materials are accessible through
            the department terminals below.
        </p>

    </div>

    <!-- DEPARTMENT TERMINALS -->

    <h3 class="section-heading">
        <i class="bi bi-grid-fill"></i>
        DEPARTMENT DATABASES
    </h3>

    <div class="row g-4">

        <!-- COURSES -->

        <div class="col-md-4">

            <div class="department-card">

                <div class="department-icon">
                    <i class="bi bi-book-fill"></i>
                </div>

                <h4>TRAINING DEPARTMENT</h4>

                <p>
                    Access course records, educational
                    information, and training archives.
                </p>

                <a asp-controller="PortfolioView"
                   asp-action="Index"
                   class="corp-button">
                    ACCESS DATABASE
                </a>

            </div>

        </div>

        <!-- PROJECTS -->

        <div class="col-md-4">

            <div class="department-card">

                <div class="department-icon">
                    <i class="bi bi-folder-fill"></i>
                </div>

                <h4>RESEARCH DEPARTMENT</h4>

                <p>
                    Review project records, descriptions,
                    and research documentation.
                </p>

                <a asp-controller="PortfolioView"
                   asp-action="Index"
                   class="corp-button">
                    ACCESS DATABASE
                </a>

            </div>

        </div>

        <!-- PROJECT IMAGES -->

        <div class="col-md-4">

            <div class="department-card">

                <div class="department-icon">
                    <i class="bi bi-images"></i>
                </div>

                <h4>ARCHIVE DEPARTMENT</h4>

                <p>
                    Browse archived project images
                    and visual documentation.
                </p>

                <a asp-controller="PortfolioView"
                   asp-action="Index"
                   class="corp-button">
                    ACCESS ARCHIVES
                </a>

            </div>

        </div>

    </div>

    <!-- CREATE PORTFOLIO -->

    <h3 class="section-heading">
        <i class="bi bi-database-fill-add"></i>
        FACILITY MANAGEMENT
    </h3>

    <div class="department-card text-center">

        <div class="department-icon">
            <i class="bi bi-file-earmark-plus"></i>
        </div>

        <h4>NEW RECORD REGISTRATION</h4>

        <p>
            Register a new course, project, and its
            corresponding visual documentation.
        </p>

        <a asp-controller="PortfolioView"
           asp-action="Create"
           class="corp-button">
            CREATE NEW RECORD
        </a>

    </div>

    <!-- FOOTER WARNING -->

    <div class="corp-footer">

        <p>
            LOBOTOMY CORPORATION // CENTRAL COMMAND SECTOR
        </p>

        <p>
            WORK SAFELY. FOLLOW PROTOCOL.
            THE FACILITY DEPENDS ON YOU.
        </p>

        <p>
            [ AUTHORIZED PERSONNEL ONLY ]
        </p>

    </div>

</div>
